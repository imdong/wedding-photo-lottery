APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

ADMIN_PASSWORD=
ADMIN_TOKEN_TTL_MINUTES=480

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

Ali_Key=
Ali_Secret=
ALIYUN_OSS_BUCKET=example-wedding-photos
ALIYUN_OSS_REGION=cn-qingdao
ALIYUN_OSS_ENDPOINT=https://oss-cn-qingdao.aliyuncs.com
ALIYUN_OSS_INTERNAL_ENDPOINT=https://oss-cn-qingdao-internal.aliyuncs.com
ALIYUN_OSS_BUCKET_URL=https://example-wedding-photos.oss-cn-qingdao.aliyuncs.com
ALIYUN_OSS_PUBLIC_URL=http://cdn.example.com
ALIYUN_OSS_ROLE_ARN=
ALIYUN_STS_ENDPOINT=https://sts.cn-qingdao.aliyuncs.com
ALIYUN_OSS_TEMPORARY_CREDENTIAL_TTL_SECONDS=900
ALIYUN_OSS_IMAGE_URL_TIMEZONE=Asia/Shanghai
ALIYUN_OSS_UPLOAD_PREFIX=wedding/photos

PHOTO_MAX_BATCH_SIZE=20
PHOTO_MAX_SIZE_MB=30
PHOTO_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic

DRAW_EXCLUDE_PREVIOUS_WINNERS=true
DRAW_MAX_PHOTOS_PER_USER=15

VITE_APP_NAME="${APP_NAME}"
